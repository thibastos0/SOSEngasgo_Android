<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="telaTitulo" parent="">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/primary_red</item>
    </style>

    <style name="btnPattern" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/primary_red</item>
        <item name="android:shadowColor">@color/primary_dark_red</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="btnOutlinedPattern" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/primary_red</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="strokeColor">@color/primary_red</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="btnTextPattern" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/gray_text</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>